# Agentic OS Enterprise — environment template.
# Copy to .env for local development. Never commit a populated .env.

# --- runtime ---------------------------------------------------------------
AGENTIC_APP_ENV=development           # development | test | staging | production
AGENTIC_LOG_LEVEL=INFO

# --- data plane ------------------------------------------------------------
AGENTIC_DATABASE_URL=postgresql+psycopg://agentic_app:agentic_app@postgres:5432/agentic
AGENTIC_DATABASE_OWNER_URL=postgresql+psycopg://agentic_owner:agentic_owner@postgres:5432/agentic
# Break-glass maintenance identity for the disaster recovery exercise only.
# It must be able to CREATE DATABASE and install extensions, which neither the
# application nor the migration role may do. Leave empty outside DR drills: the
# exercise then reports NOT_RUN rather than inventing restore evidence.
# Draw the real value from the secret manager; never commit it.
# --- model providers ---------------------------------------------------------
# The platform runs on deterministic local providers by default. Set this to
# true only once a provider is configured AND its data handling is approved.
AGENTIC_MODEL_ALLOW_EXTERNAL_PROVIDERS=false

# Named OpenAI-compatible endpoints, as JSON, so a self-hosted open-weights
# deployment and a third-party host can be registered at the same time. Each
# model entry in models/registry.yaml selects one by name.
#
#   onprem-vllm  serves private-general (Llama 3.3 70B) — RESTRICTED-capable,
#                because the weights and the inference stay inside the
#                residency boundary
#   onprem-ollama serves private-fast (Qwen2.5 7B) for classification volume
#   oss-cloud    serves oss-cloud-fast — open weights, third-party inference,
#                capped at CONFIDENTIAL
#
# api_key_ref is a *reference* the secret broker resolves at call time. Never
# put a key here. A privately operated endpoint usually needs none at all.
#
# AGENTIC_MODEL_ENDPOINTS={"onprem-vllm":{"base_url":"http://vllm.internal/v1","external":false},"onprem-ollama":{"base_url":"http://ollama.internal/v1","external":false},"oss-cloud":{"base_url":"https://api.groq.com/openai/v1","api_key_ref":"model.oss_cloud","external":true}}
AGENTIC_MODEL_ENDPOINTS=

# Single-endpoint shorthand, used when a model entry names no endpoint.
# Ollama and vLLM expose the compatible surface under /v1 — omitting it 404s.
AGENTIC_LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
AGENTIC_ANTHROPIC_API_KEY=
AGENTIC_OPENAI_API_KEY=

AGENTIC_DR_ADMIN_URL=
AGENTIC_DR_ARTIFACT_PATH=./.data/backups
AGENTIC_REDIS_URL=redis://redis:6379/0
AGENTIC_OBJECT_STORE_PATH=./.data/objects

# --- security --------------------------------------------------------------
# Required outside development. Generate with: openssl rand -base64 48
AGENTIC_JWT_SECRET=
AGENTIC_ACCESS_TOKEN_TTL_SECONDS=3600
AGENTIC_REFRESH_TOKEN_TTL_SECONDS=604800
AGENTIC_PASSWORD_MIN_LENGTH=12

# Secret storage: env (development) | file | vault
AGENTIC_SECRET_BACKEND=env
AGENTIC_SECRET_FILE_PATH=./.data/secrets.json
AGENTIC_VAULT_ADDR=

# Envelope encryption: local (development only) | aws-kms | azure-kv | gcp-kms
# The local backend is rejected at startup in staging and production.
AGENTIC_KMS_BACKEND=local
AGENTIC_KMS_LOCAL_KEY=

# --- governance ------------------------------------------------------------
AGENTIC_POLICY_MODE=enforce           # enforce | monitor
AGENTIC_EVIDENCE_SIGNING_MODE=development

# --- AI plane --------------------------------------------------------------
# The platform runs fully offline on the deterministic provider. External
# providers stay inert until BOTH a key is present and the flag below is true.
AGENTIC_DEFAULT_MODEL_PROVIDER=deterministic
AGENTIC_MODEL_ALLOW_EXTERNAL_PROVIDERS=false
AGENTIC_ANTHROPIC_API_KEY=
AGENTIC_OPENAI_API_KEY=
AGENTIC_LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434
AGENTIC_EMBEDDING_PROVIDER=deterministic-hash
AGENTIC_EMBEDDING_DIMENSIONS=384

# --- budgets ---------------------------------------------------------------
AGENTIC_DEFAULT_TENANT_DAILY_COST_CAP_USD=250
AGENTIC_DEFAULT_RUN_COST_CAP_USD=5
AGENTIC_DEFAULT_RUN_TOKEN_CAP=250000

# --- egress ----------------------------------------------------------------
# Comma-separated hostnames the tool gateway may reach. Empty blocks all
# outbound tool traffic.
AGENTIC_EGRESS_ALLOWLIST=
AGENTIC_EGRESS_BLOCK_PRIVATE_NETWORKS=true

# --- api / observability ---------------------------------------------------
AGENTIC_CORS_ALLOWED_ORIGINS=http://localhost:3000
AGENTIC_RATE_LIMIT_PER_MINUTE=240
AGENTIC_OTEL_EXPORTER_OTLP_ENDPOINT=
AGENTIC_OTEL_SERVICE_NAME=agentic-os-api
